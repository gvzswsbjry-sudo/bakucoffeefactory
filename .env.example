# Runtime
NODE_ENV=development
HOST=127.0.0.1
PORT=8017

# PostgreSQL customer accounts (never commit the real value)
DATABASE_URL=postgresql://bcf_user:replace_me@127.0.0.1:5432/baku_coffee_factory

# Production-only bootstrap secret. Use at least 12 random characters, then rotate it.
ADMIN_INITIAL_PASSWORD=replace-with-a-long-random-password

# Comma-separated HTTPS origins allowed to make authenticated browser requests.
ALLOWED_ORIGINS=https://bakucoffeefactory.az,https://www.bakucoffeefactory.az

# Set to 1 only behind a trusted reverse proxy such as Render, Nginx, or Cloudflare.
TRUST_PROXY=0

# Social login public client identifiers. Leave blank to hide/disable the
# provider button until the domain and redirect URL are registered.
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=
